#!/bin/sh
# The static checks and the unit and HTTP tests, which need nothing but Node.js. The integration tests (Docker) and the
# browser check (Google Chrome) run in continuous integration, which gates every merge into main.
# git exports GIT_DIR and similar variables to hooks; a test that runs git would otherwise act on
# this repository instead of its own scratch repository.
unset $(git rev-parse --local-env-vars)
npm run --silent check || exit 1
exec npm run --silent test:unit
