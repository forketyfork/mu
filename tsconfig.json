{
  "compilerOptions": {
    "target": "es2025",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2025", "dom", "dom.iterable"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsc/tsbuildinfo",
    "paths": {
      "/vendor/marked.js": ["./node_modules/marked/lib/marked.d.ts"],
      "/vendor/purify.js": ["./node_modules/dompurify/dist/purify.es.d.mts"]
    }
  },
  "include": ["src", "scripts", "tests", "public", "*.mjs"]
}
