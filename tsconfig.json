{
  "compilerOptions": {
    "target": "es2025",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2025", "dom", "dom.iterable"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsc/tsbuildinfo",
    "paths": {
      "/vendor/anime.js": ["./node_modules/animejs/dist/modules/index.d.ts"],
      "/vendor/marked.js": ["./node_modules/marked/lib/marked.d.ts"],
      "/vendor/purify.js": ["./node_modules/dompurify/dist/purify.es.d.mts"],
      "/vendor/highlight/core.js": ["./node_modules/highlight.js/lib/core.d.ts"],
      "/vendor/mermaid/mermaid.esm.min.mjs": ["./node_modules/mermaid/dist/mermaid.d.ts"],
      "/visual/format.js": ["./src/visual-format.mjs"],
      "/visual/render.js": ["./public/visual/render.js"],
      "/visual/anchor.js": ["./public/visual/anchor.js"],
      "/visual/marks.js": ["./public/visual/marks.js"],
      "/visual/sheen.js": ["./public/visual/sheen.js"],
      "/visual/form.js": ["./public/visual/form.js"],
      "/visual/scene.js": ["./public/visual/scene.js"],
      "/visual/patch.js": ["./public/visual/patch.js"]
    }
  },
  "include": ["src", "scripts", "tests", "public", "*.mjs"]
}
