{
  "name": "mu-agent-room",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local IRC room and dashboard for CLI agent teams",
  "license": "MIT",
  "author": "Forketyfork <forketyfork@icloud.com>",
  "repository": "github:forketyfork/mu",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "chat:up": "docker compose up -d --wait",
    "chat:down": "docker compose down",
    "service:install": "node src/launchd.mjs install",
    "service:uninstall": "node src/launchd.mjs uninstall",
    "pretest": "node scripts/ensure-deps.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "test": "node --test --test-force-exit tests/*.test.mjs tests/*.integration.mjs public/model.test.js",
    "test:integration": "node --test --test-force-exit tests/*.integration.mjs",
    "mu": "node src/cli.mjs",
    "typecheck": "tsc -p .",
    "lint": "eslint --max-warnings 0 . && stylelint --max-warnings 0 'public/**/*.css'",
    "format": "prettier --write . && stylelint --fix 'public/**/*.css'",
    "format:check": "prettier --check .",
    "precheck": "node scripts/ensure-deps.mjs",
    "check": "npm run --silent typecheck && npm run --silent lint && npm run --silent format:check"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "irc-framework": "4.14.0",
    "marked": "18.1.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "eslint-plugin-n": "18.5.0",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
